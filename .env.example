# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
# 1. Create a bot: Open Telegram, search for @BotFather, send /newbot and follow prompts.
# 2. Copy the HTTP API token provided by BotFather into TELEGRAM_BOT_TOKEN below.
# 3. Find your Chat ID:
#    - Start your new bot by pressing "Start" or sending any message to it.
#    - Search for @userinfobot on Telegram and press Start (it will reply with your numerical Id).
#    - Or visit: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates and look for "chat":{"id": 123456789}
# ==============================================================================

TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

# Optional: Override target roles (comma-separated list, case-insensitive)
# TARGET_ROLES="data scientist, senior data analyst, analytics engineer, decision scientist"

# Optional: Max number of roles delivered in the morning digest (default: 10)
# MAX_ALERTS_PER_RUN=10
